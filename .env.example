# Claude API key used by the background watcher to write ideas.
# (Inside Claude Desktop, Claude itself writes ideas from the MCP tools, so this is optional there.)
ANTHROPIC_API_KEY=

# Optional: YouTube Data API v3 key enables the YouTube trend source.
YOUTUBE_API_KEY=
# Optional: your channel id (starts with UC, see youtube.com/account_advanced).
# With the key above, CreatorHub learns which of your niches perform best.
YOUTUBE_CHANNEL_ID=

# Optional: Notion sync. Create an integration, share a database with it, and paste its id.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notifications: set any of these to get pinged when something pops up.
NTFY_TOPIC=            # phone push via https://ntfy.sh (pick a long, unguessable topic name)
DISCORD_WEBHOOK_URL=
DESKTOP_NOTIFICATIONS=1

# Local hour (0-23) for the daily digest, or "off"
CREATORHUB_DIGEST_HOUR=8

# Where the profile and database live (defaults to ~/.creatorhub/)
CREATORHUB_HOME=
# Minutes between background scans
CREATORHUB_SCAN_INTERVAL=60
# Set to 1 to also run the watcher inside the MCP server process
CREATORHUB_WATCH_IN_SERVER=0
